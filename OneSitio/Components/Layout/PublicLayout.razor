@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-white">
    <!-- Clean, Spacious Civic Navbar -->
    <header class="civic-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Brand -->
            <a class="civic-brand" href="/">
                <img src="images/talampas-logo.png" alt="Sangguniang Barangay ng Talampas Seal" class="brand-crest" />
                <div>
                    <div class="brand-title">OneSitio</div>
                    <div class="brand-subtitle">Sangguniang Barangay ng Talampas &bull; Bustos, Bulacan</div>
                </div>
            </a>

            <!-- Desktop Navigation Menu -->
            <nav class="d-none d-lg-flex align-items-center gap-2">
                <a class="nav-link-custom" href="/">Home</a>
                <a class="nav-link-custom" href="/#services">Services & Documents</a>
                <a class="nav-link-custom" href="/#tracker">Track Request</a>
                <a class="nav-link-custom" href="/#transparency">Blockchain Transparency</a>
                <a class="nav-link-custom" href="/#projects">Projects</a>
                <a class="nav-link-custom" href="/#faq">FAQ</a>
            </nav>

            <!-- Action CTAs -->
            <div class="d-flex align-items-center gap-3">
                <a href="/login" class="btn btn-civic-ghost">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                </a>
                <a href="/register" class="btn btn-civic-primary">
                    <i class="bi bi-person-plus-fill me-1"></i> Register as Resident
                </a>
            </div>
        </div>

        <!-- Mobile Navigation Bar for small screens -->
        <div class="d-lg-none container border-top mt-2 pt-2">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="nav-link-custom py-1 px-3 small" href="/">Home</a>
                <a class="nav-link-custom py-1 px-3 small" href="/#services">Services</a>
                <a class="nav-link-custom py-1 px-3 small" href="/#tracker">Tracker</a>
                <a class="nav-link-custom py-1 px-3 small" href="/#transparency">Transparency</a>
                <a class="nav-link-custom py-1 px-3 small" href="/#projects">Projects</a>
                <a class="nav-link-custom py-1 px-3 small" href="/#faq">FAQ</a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1 bg-white">
        @Body
    </main>

    <!-- Clean All-White Civic Footer -->
    <footer class="civic-footer-clean">
        <div class="container">
            <div class="row g-5 justify-content-between">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="images/talampas-logo.png" alt="Sangguniang Barangay ng Talampas Logo" style="width: 54px; height: 54px; border-radius: 50%; border: 2px solid #e2e8f0;" />
                        <div>
                            <h4 class="mb-0 fw-bold" style="color: #174836;">Barangay Talampas</h4>
                            <div class="text-muted small fw-semibold">Bustos, Lalawigan ng Bulacan</div>
                        </div>
                    </div>
                    <p class="text-secondary small pe-lg-4 mb-3">
                        Opisyal na e-Governance at Cryptographic Blockchain Transparency Portal ng Sangguniang Barangay ng Talampas. Mabilis na pagproseso ng mga dokumento, PayMongo digital payments, at tapat na pagsubaybay sa pondo ng bayan.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-success border border-success-subtle px-3 py-2 small fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> RA 10173 Compliant
                        </span>
                        <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2 small fw-semibold">
                            <i class="bi bi-lock me-1"></i> 256-Bit SSL Secured
                        </span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5>e-Services</h5>
                    <ul class="footer-links">
                        <li><a href="/#services"><i class="bi bi-chevron-right small text-success me-1"></i> Barangay Clearance</a></li>
                        <li><a href="/#services"><i class="bi bi-chevron-right small text-success me-1"></i> Certificate of Indigency</a></li>
                        <li><a href="/#services"><i class="bi bi-chevron-right small text-success me-1"></i> Certificate of Residency</a></li>
                        <li><a href="/#services"><i class="bi bi-chevron-right small text-success me-1"></i> Business Clearance</a></li>
                        <li><a href="/#tracker"><i class="bi bi-chevron-right small text-success me-1"></i> Request Tracking</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h5>Transparency & Funds</h5>
                    <ul class="footer-links">
                        <li><a href="/#transparency"><i class="bi bi-shield-lock text-success me-1"></i> SHA-256 Ledger Blocks</a></li>
                        <li><a href="/#transparency"><i class="bi bi-pie-chart text-success me-1"></i> General Fund Allocation</a></li>
                        <li><a href="/#transparency"><i class="bi bi-wallet2 text-success me-1"></i> 20% Development Fund</a></li>
                        <li><a href="/#projects"><i class="bi bi-camera text-success me-1"></i> Project Photo Galleries</a></li>
                        <li><a href="/#faq"><i class="bi bi-question-circle text-success me-1"></i> Citizen Help & Verification</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Barangay Hall Contact</h5>
                    <div class="small text-secondary">
                        <p class="mb-2">
                            <i class="bi bi-geo-alt-fill text-success me-2"></i>
                            Barangay Hall ng Talampas, Bustos, Bulacan 3007
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-telephone-fill text-success me-2"></i>
                            (044) 766-1829 / (044) 766-1830
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-phone-fill text-success me-2"></i>
                            +63 917 888 2749 (SMS Hotlines)
                        </p>
                        <p class="mb-0">
                            <i class="bi bi-clock-fill text-success me-2"></i>
                            Lunes – Biyernes: 8:00 AM – 5:00 PM
                        </p>
                    </div>
                </div>
            </div>

            <div class="footer-bottom-clean d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    &copy; 2026 <strong>OneSitio &bull; Sangguniang Barangay ng Talampas, Bustos, Bulacan</strong>. All rights reserved.
                </div>
                <div class="d-flex gap-4">
                    <a href="/#faq" class="text-muted small">Terms of Service</a>
                    <a href="/#faq" class="text-muted small">Data Privacy Manual</a>
                    <a href="/login" class="text-muted small">Staff Portal Access</a>
                </div>
            </div>
        </div>
    </footer>
</div>
