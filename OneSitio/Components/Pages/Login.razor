@page "/login"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Login &bull; Sangguniang Barangay ng Talampas, Bustos, Bulacan</PageTitle>

<div class="auth-page-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <img src="images/talampas-logo.png" alt="Barangay Talampas Logo" class="auth-header-seal" />
            <h3 class="fw-bold text-dark mb-1">Welcome to OneSitio</h3>
            <p class="text-muted small mb-0">Sangguniang Barangay ng Talampas &bull; Bustos, Bulacan</p>
        </div>

        <!-- Role Switcher Tabs -->
        <div class="auth-tabs">
            <button type="button" class="auth-tab-btn @(isStaffMode ? "" : "active")" @onclick="() => SwitchRole(false)">
                <i class="bi bi-person-fill me-1"></i> Resident Portal
            </button>
            <button type="button" class="auth-tab-btn @(isStaffMode ? "active" : "")" @onclick="() => SwitchRole(true)">
                <i class="bi bi-shield-lock-fill me-1"></i> Barangay Staff / Opisyal
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@errorMessage</div>
            </div>
        }

        @if (loginSuccess)
        {
            <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill"></i>
                <div>Authentication successful! Redirecting to Resident Workspace...</div>
            </div>
        }

        <form @onsubmit="HandleLogin">
            <div class="mb-3">
                <label class="form-label">
                    @(isStaffMode ? "Official Staff Email / ID" : "Resident ID, Email, o Mobile No.")
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi @(isStaffMode ? "bi-building-fill-lock" : "bi-person-badge")"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" placeholder="@(isStaffMode ? "Halimbawa: secretary@talampas.gov.ph" : "Halimbawa: resident@email.com o RES-TAL-2026-001")" @bind="username" required />
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label mb-0">Password</label>
                    <a href="javascript:void(0)" class="text-secondary small" @onclick="() => showForgotHelper = !showForgotHelper">
                        Nakalimutan ang Password?
                    </a>
                </div>
                <div class="input-group mt-1">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0" placeholder="Ipasok ang inyong password" @bind="password" required />
                    <button type="button" class="input-group-text bg-light text-muted border-start-0" @onclick="() => showPassword = !showPassword">
                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            @if (showForgotHelper)
            {
                <div class="alert alert-info py-2 px-3 small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Para sa seguridad, ang password reset ay nangangailangan ng OTP na ipapadala sa inyong rehistradong mobile number o pagtungo sa tanggapan ng Kalihim sa Barangay Hall ng Talampas.
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe" @bind="rememberMe" />
                    <label class="form-check-label text-muted small" for="rememberMe">
                        Tandaan ang device na ito
                    </label>
                </div>
                <span class="badge bg-light text-muted border small">SSL Encrypted</span>
            </div>

            <button type="submit" class="btn btn-civic-primary w-100 py-2 fs-6 fw-bold mb-3 shadow-sm" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Sinusuri ang Credentials...</span>
                }
                else
                {
                    <span>Mag-login sa @(isStaffMode ? "Staff Portal" : "Resident Workspace") <i class="bi bi-arrow-right ms-1"></i></span>
                }
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">Bagong residente sa Barangay Talampas?</span>
            <a href="/register" class="fw-bold text-success ms-1 small">
                Magrehistro ng bagong resident account &rarr;
            </a>
        </div>
    </div>
</div>

@code {
    private bool isStaffMode = false;
    private string username = "";
    private string password = "";
    private bool showPassword = false;
    private bool rememberMe = false;
    private bool showForgotHelper = false;
    private bool isSubmitting = false;
    private bool loginSuccess = false;
    private string errorMessage = "";

    private void SwitchRole(bool staff)
    {
        isStaffMode = staff;
        errorMessage = "";
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Mangyaring ilagay ang inyong email/ID at password.";
            return;
        }

        isSubmitting = true;
        errorMessage = "";
        await Task.Delay(400);
        isSubmitting = false;
        loginSuccess = true;
        await Task.Delay(250);
        Navigation.NavigateTo("/resident");
    }
}
