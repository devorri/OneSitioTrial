@page "/register"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Rehistrasyon ng Residente &bull; Sangguniang Barangay ng Talampas, Bustos, Bulacan</PageTitle>

<div class="auth-page-wrapper">
    <div class="auth-card auth-card-wide">
        <!-- Header -->
        <div class="auth-header">
            <img src="images/talampas-logo.png" alt="Barangay Talampas Logo" class="auth-header-seal" />
            <h3 class="fw-bold text-dark mb-1">Citizen Registration & Verification</h3>
            <p class="text-muted small mb-0">Sangguniang Barangay ng Talampas &bull; Bustos, Bulacan &bull; Edad 15 pataas</p>
        </div>

        @if (currentStep <= 4)
        {
            <!-- Wizard Progress Indicator -->
            <div class="wizard-progress">
                <div class="wizard-step-node @(currentStep >= 1 ? (currentStep == 1 ? "active" : "completed") : "")" @onclick="() => GoToStep(1)">
                    <div class="wizard-circle">
                        @(currentStep > 1 ? "✓" : "1")
                    </div>
                    <div class="wizard-label d-none d-sm-block">Personal Details</div>
                </div>
                <div class="wizard-step-node @(currentStep >= 2 ? (currentStep == 2 ? "active" : "completed") : "")" @onclick="() => GoToStep(2)">
                    <div class="wizard-circle">
                        @(currentStep > 2 ? "✓" : "2")
                    </div>
                    <div class="wizard-label d-none d-sm-block">ID & OCR Pre-Check</div>
                </div>
                <div class="wizard-step-node @(currentStep >= 3 ? (currentStep == 3 ? "active" : "completed") : "")" @onclick="() => GoToStep(3)">
                    <div class="wizard-circle">
                        @(currentStep > 3 ? "✓" : "3")
                    </div>
                    <div class="wizard-label d-none d-sm-block">Live Photo</div>
                </div>
                <div class="wizard-step-node @(currentStep >= 4 ? (currentStep == 4 ? "active" : "completed") : "")" @onclick="() => GoToStep(4)">
                    <div class="wizard-circle">
                        4
                    </div>
                    <div class="wizard-label d-none d-sm-block">Household & Security</div>
                </div>
            </div>
        }

        <!-- STEP 1: Personal Details -->
        @if (currentStep == 1)
        {
            <div>
                <div class="mb-3">
                    <h5 class="fw-bold text-dark mb-1">Step 1: Impormasyon ng Residente & Eligibility (15+)</h5>
                    <p class="text-muted small mb-0">Ilagay ang inyong opisyal na impormasyon ayon sa inyong Birth Certificate o Valid ID.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Unang Pangalan (First Name) *</label>
                        <input type="text" class="form-control" @bind="firstName" placeholder="Hal. Juan" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Gitnang Pangalan (Middle Name)</label>
                        <input type="text" class="form-control" @bind="middleName" placeholder="Hal. Castro" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Apelyido (Last Name) *</label>
                        <input type="text" class="form-control" @bind="lastName" placeholder="Hal. Dela Cruz" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Suffix</label>
                        <input type="text" class="form-control" @bind="suffix" placeholder="Jr., III, atbp." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Araw ng Kapanganakan *</label>
                        <input type="date" class="form-control" @bind="birthDate" @bind:after="CalculateAge" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Edad & Eligibility</label>
                        <div class="p-2 border rounded bg-light text-center">
                            @if (calculatedAge >= 15)
                            {
                                <span class="text-success fw-bold small">
                                    <i class="bi bi-check-circle-fill me-1"></i> Edad @calculatedAge (Eligible para sa Talampas Account)
                                </span>
                            }
                            else if (calculatedAge > 0)
                            {
                                <span class="text-danger fw-bold small">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i> Edad @calculatedAge (Dapat 15 pataas)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Pumili ng petsa ng kapanganakan</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Katayuang Sibil *</label>
                        <select class="form-select" @bind="civilStatus">
                            <option value="Single">Walang Asawa (Single)</option>
                            <option value="Married">May Asawa (Married)</option>
                            <option value="Widowed">Biyudo/Biyuda (Widowed)</option>
                            <option value="Separated">Hiwalay (Separated)</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mobile Contact No. (+63) *</label>
                        <input type="tel" class="form-control" @bind="mobileNumber" placeholder="Hal. 0917 123 4567" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address *</label>
                        <input type="email" class="form-control" @bind="email" placeholder="Hal. juandelacruz@gmail.com" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Purok / Sitio sa Barangay Talampas *</label>
                        <select class="form-select" @bind="purok">
                            <option value="Purok 1 (Centrong Bayan)">Purok 1 (Centrong Bayan)</option>
                            <option value="Purok 2 (Tabing-Ilog)">Purok 2 (Tabing-Ilog)</option>
                            <option value="Purok 3 (Gulod)">Purok 3 (Gulod)</option>
                            <option value="Purok 4 (Bustos Dam Road)">Purok 4 (Bustos Dam Road)</option>
                            <option value="Purok 5 (San Isidro)">Purok 5 (San Isidro)</option>
                            <option value="Purok 6 (Kabyawan)">Purok 6 (Kabyawan)</option>
                            <option value="Sitio Dulo">Sitio Dulo</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bahay Blg. / Kalye (Street Address) *</label>
                        <input type="text" class="form-control" @bind="streetAddress" placeholder="Hal. 124 Purok 2, Talampas" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a href="/login" class="text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Nakarehistro na? Mag-log in
                    </a>
                    <button type="button" class="btn btn-civic-primary px-4 fw-bold" @onclick="() => NextStep(2)">
                        Susunod: ID & OCR Pre-Check <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }

        <!-- STEP 2: Government ID & OCR Pre-Checking Engine -->
        @if (currentStep == 2)
        {
            <div>
                <div class="mb-3">
                    <h5 class="fw-bold text-dark mb-1">Step 2: Upload ng Valid ID & OCR Pre-Checking</h5>
                    <p class="text-muted small mb-0">I-upload ang inyong opisyal na ID. Awtomatikong kukunin ng OCR system ang datos upang mapabilis ang pagproseso ng Kalihim.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Uri ng Government ID *</label>
                        <select class="form-select" @bind="idType">
                            <option value="Philippine National ID (PhilSys)">Philippine National ID (PhilSys)</option>
                            <option value="COMELEC Voter's ID / Certificate (Bustos)">COMELEC Voter's ID / Certificate (Bustos)</option>
                            <option value="Unified Multi-Purpose ID (UMID)">Unified Multi-Purpose ID (UMID)</option>
                            <option value="Driver's License (LTO)">Driver's License (LTO)</option>
                            <option value="Postal ID">Postal ID</option>
                            <option value="Student ID (Ages 15-17)">Student ID (Edad 15–17)</option>
                            <option value="Senior Citizen ID">Senior Citizen ID</option>
                            <option value="Philippine Passport">Philippine Passport</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ID Serial Number (Opsyonal kung babasahin ng OCR)</label>
                        <input type="text" class="form-control font-monospace" @bind="idNumber" placeholder="Hal. 1234-5678-9012" />
                    </div>
                </div>

                <!-- ID File Upload Area -->
                <div class="p-3 bg-light rounded-3 border mt-3">
                    <label class="form-label fw-bold text-dark mb-1">
                        <i class="bi bi-cloud-arrow-up-fill text-success me-1"></i> I-upload ang Larawan ng Valid ID
                    </label>
                    <input type="file" class="form-control" accept="image/*,.pdf" @onchange="OnFileUploaded" />
                    <div class="form-text text-muted">Tinatanggap ang PNG, JPG, o JPEG na malinaw at nababasa ang teksto.</div>
                </div>

                <!-- OCR Scanner Display -->
                <div class="ocr-scanner-box mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-dark fw-bold">
                            <i class="bi bi-cpu-fill text-success me-1"></i> TALAMPAS ONESITIO OCR SCANNER ENGINE
                        </span>
                        @if (ocrScanned)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-patch-check-fill me-1"></i> OCR Extraction Complete
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">
                                @(idUploaded ? "Handa nang i-scan" : "Mag-upload muna ng ID")
                            </span>
                        }
                    </div>

                    @if (idUploaded)
                    {
                        <div class="ocr-id-preview">
                            <img src="images/sample_gov_id_talampas.jpg" alt="Uploaded Government ID Specimen" />
                            @if (isScanningOcr)
                            {
                                <div class="ocr-laser-line"></div>
                            }
                            @if (ocrScanned)
                            {
                                <div class="ocr-target-box" style="top: 40%; left: 41%; width: 32%; height: 18%;"></div>
                                <div class="ocr-target-box" style="top: 60%; left: 45%; width: 42%; height: 20%;"></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center border rounded-3 bg-white text-muted">
                            <i class="bi bi-card-image fs-1 text-secondary opacity-50 d-block mb-2"></i>
                            <div class="fw-semibold">Wala pang na-upload na ID file</div>
                            <div class="small">Pumili ng file sa itaas upang simulan ang pagsusuri</div>
                        </div>
                    }

                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-sm btn-civic-primary px-3 fw-bold" @onclick="TriggerOcrScan" disabled="@(isScanningOcr || !idUploaded)">
                            @if (isScanningOcr)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Binabasa ang Datos ng ID...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-upc-scan me-1"></i> I-scan ang ID gamit ang OCR</span>
                            }
                        </button>
                    </div>

                    @if (ocrScanned)
                    {
                        <div class="row g-2 mt-3 pt-3 border-top">
                            <div class="col-md-4">
                                <div class="ocr-extracted-badge">
                                    <div class="key">PANGALAN:</div>
                                    <div class="val">@(string.IsNullOrWhiteSpace(firstName) ? "BERIPIKADO" : $"{firstName.ToUpper()} {lastName.ToUpper()}")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ocr-extracted-badge">
                                    <div class="key">ID SERIAL:</div>
                                    <div class="val font-monospace">@idNumber</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ocr-extracted-badge">
                                    <div class="key">LOKASYON:</div>
                                    <div class="val">TALAMPAS, BUSTOS</div>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-success mt-2 py-2 px-3 small mb-0 text-success bg-success bg-opacity-10 border border-success-subtle d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span>Matagumpay na na-scan ang ID. Ipinasa ang datos para sa opisyal na beripikasyon ng Kalihim.</span>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary px-3" @onclick="() => GoToStep(1)">
                        <i class="bi bi-arrow-left me-1"></i> Bumalik
                    </button>
                    <button type="button" class="btn btn-civic-primary px-4 fw-bold" @onclick="() => NextStep(3)">
                        Susunod: Live Selfie Verification <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }

        <!-- STEP 3: Live Selfie / Biometric Photo -->
        @if (currentStep == 3)
        {
            <div>
                <div class="mb-3">
                    <h5 class="fw-bold text-dark mb-1">Step 3: Live Photo & Biometric Verification</h5>
                    <p class="text-muted small mb-0">Kumuha o mag-upload ng malinaw na larawan ng inyong mukha para sa beripikasyon.</p>
                </div>

                <div class="text-center py-2">
                    @if (selfieCaptured)
                    {
                        <div class="selfie-guide-box">
                            <img src="images/sample_resident_selfie.jpg" alt="Biometric Face Capture" />
                        </div>
                    }
                    else
                    {
                        <div class="p-5 border rounded-3 bg-light text-center mb-3">
                            <i class="bi bi-camera-fill text-muted fs-1 d-block mb-2"></i>
                            <div class="fw-bold text-dark">Wala pang kuha ng larawan</div>
                            <div class="text-muted small">Pindutin ang buton sa ibaba upang buksan ang camera o mag-upload</div>
                        </div>
                    }

                    <div class="d-inline-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-civic-primary px-3 fw-semibold" @onclick="CaptureSelfie">
                            <i class="bi bi-camera-fill me-1"></i> @(selfieCaptured ? "Kuhaan Muli ang Larawan" : "Kumuha ng Larawan (Camera)")
                        </button>
                    </div>
                </div>

                <div class="card bg-light border p-3 rounded-3">
                    <h6 class="fw-bold text-dark mb-2 small"><i class="bi bi-shield-check text-success me-1"></i> Mga Tagubilin sa Pagkuha ng Larawan</h6>
                    <div class="row g-2 small text-secondary">
                        <div class="col-md-4">
                            <i class="bi bi-check2-circle text-success me-1"></i> Walang suot na sombrero o mask
                        </div>
                        <div class="col-md-4">
                            <i class="bi bi-check2-circle text-success me-1"></i> Maliwanag at nakaharap sa camera
                        </div>
                        <div class="col-md-4">
                            <i class="bi bi-check2-circle text-success me-1"></i> Tugma sa larawan sa inyong Valid ID
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary px-3" @onclick="() => GoToStep(2)">
                        <i class="bi bi-arrow-left me-1"></i> Bumalik
                    </button>
                    <button type="button" class="btn btn-civic-primary px-4 fw-bold" @onclick="() => NextStep(4)">
                        Susunod: Household & Seguridad <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }

        <!-- STEP 4: Household & Security Setup -->
        @if (currentStep == 4)
        {
            <div>
                <h5 class="fw-bold text-dark mb-3">Step 4: Household Profile & Seguridad ng Account</h5>

                <!-- Household Head Checkbox -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="householdSwitch" @bind="isHouseholdHead" />
                        <label class="form-check-label fw-bold text-dark" for="householdSwitch">
                            Magrehistro bilang Punong-Sambahayan (Head of Household)
                        </label>
                    </div>
                    <p class="text-muted small mb-0">
                        Pinapahintulutan ang magulang o guardian na magdagdag ng mga miyembro ng pamilya (mga menor-de-edad wala pang 15 anyos o mga lolo/lola) upang makapag-request ng clearance para sa kanila.
                    </p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Gumawa ng Password *</label>
                        <input type="password" class="form-control" @bind="password" placeholder="Hindi bababa sa 8 characters" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kumpirmahin ang Password *</label>
                        <input type="password" class="form-control" @bind="confirmPassword" placeholder="Ipasok muli ang password" required />
                    </div>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="privacyConsent" @bind="consentPrivacy" required />
                    <label class="form-check-label text-secondary small" for="privacyConsent">
                        Pinatutunayan ko sa ilalim ng kaparusahan ng batas na ang lahat ng impormasyong ibinigay ay totoo at tama. Sumasang-ayon ako sa paggamit ng aking datos ng <strong>Sangguniang Barangay ng Talampas, Bustos, Bulacan</strong> alinsunod sa <strong>Republic Act No. 10173 (Data Privacy Act of 2012)</strong>.
                    </label>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary px-3" @onclick="() => GoToStep(3)">
                        <i class="bi bi-arrow-left me-1"></i> Bumalik
                    </button>
                    <button type="button" class="btn btn-civic-primary px-4 py-2 fs-6 fw-bold" @onclick="SubmitRegistration" disabled="@(!consentPrivacy || isSubmitting)">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Ipinapadala sa Kalihim...</span>
                        }
                        else
                        {
                            <span>Kumpletuhin at Isumite ang Rehistrasyon <i class="bi bi-check-lg ms-1"></i></span>
                        }
                    </button>
                </div>
            </div>
        }

        <!-- STEP 5: Success & Verification Preview -->
        @if (currentStep == 5)
        {
            <div class="text-center py-3">
                <div class="mb-3">
                    <span class="badge bg-success p-3 rounded-circle fs-2 shadow-sm">
                        <i class="bi bi-check-lg text-white"></i>
                    </span>
                </div>

                <h3 class="fw-bold text-dark mb-1">Matagumpay na Naisumite ang Rehistrasyon!</h3>
                <p class="text-muted small mb-4">
                    Provisional Resident Reference Code: <strong class="text-success fs-5 font-monospace">REG-TAL-2026-0842</strong>
                </p>

                <div class="card bg-light border p-4 text-start mx-auto mb-4" style="max-width: 620px;">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Buod ng Aplikasyon sa Barangay Talampas</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-6 text-muted">Aplikante:</div>
                        <div class="col-sm-6 fw-bold text-dark">
                            @(string.IsNullOrWhiteSpace(firstName) ? "Residente ng Talampas" : $"{firstName} {middleName} {lastName} {suffix}".Trim())
                        </div>

                        <div class="col-sm-6 text-muted">Araw ng Kapanganakan:</div>
                        <div class="col-sm-6 fw-semibold">
                            @birthDate.ToString("MMMM dd, yyyy") (@calculatedAge anyos)
                        </div>

                        <div class="col-sm-6 text-muted">Tirahan sa Talampas:</div>
                        <div class="col-sm-6 fw-semibold">
                            @(string.IsNullOrWhiteSpace(streetAddress) ? purok : $"{streetAddress}, {purok}"), Barangay Talampas, Bustos, Bulacan
                        </div>

                        <div class="col-sm-6 text-muted">ID Verification:</div>
                        <div class="col-sm-6 text-success fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> @idType @(ocrScanned ? "(OCR Pre-Checked)" : "(Nai-upload)")
                        </div>

                        <div class="col-sm-6 text-muted">Katayuan sa Sambahayan:</div>
                        <div class="col-sm-6 fw-semibold">
                            @(isHouseholdHead ? "Punong-Sambahayan (Head of Household)" : "Miyembro ng Sambahayan")
                        </div>

                        <div class="col-sm-6 text-muted">Pagsusuri ng Kalihim:</div>
                        <div class="col-sm-6 text-primary fw-bold">
                            <i class="bi bi-hourglass-split me-1"></i> Ipinasa kay Kalihim Elena Bautista
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/login" class="btn btn-civic-primary px-4 py-2 fw-bold">
                        Pumunta sa Resident Login <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a href="/" class="btn btn-outline-secondary px-4 py-2">
                        Bumalik sa Home
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int currentStep = 1;
    private string firstName = "";
    private string middleName = "";
    private string lastName = "";
    private string suffix = "";
    private DateTime birthDate = DateTime.Today.AddYears(-20);
    private int calculatedAge = 20;
    private string civilStatus = "Single";
    private string mobileNumber = "";
    private string email = "";
    private string purok = "Purok 1 (Centrong Bayan)";
    private string streetAddress = "";

    private string idType = "Philippine National ID (PhilSys)";
    private string idNumber = "";
    private bool isScanningOcr = false;
    private bool ocrScanned = false;
    private bool idUploaded = false;

    private bool selfieCaptured = false;

    private bool isHouseholdHead = false;
    private string password = "";
    private string confirmPassword = "";
    private bool consentPrivacy = false;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        CalculateAge();
    }

    private void CalculateAge()
    {
        var today = DateTime.Today;
        calculatedAge = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-calculatedAge)) calculatedAge--;
    }

    private void GoToStep(int step)
    {
        if (step <= currentStep || step <= 4)
        {
            currentStep = step;
        }
    }

    private void NextStep(int target)
    {
        currentStep = target;
    }

    private void OnFileUploaded(ChangeEventArgs e)
    {
        idUploaded = true;
        if (string.IsNullOrWhiteSpace(idNumber))
        {
            idNumber = "8942-5018-9120";
        }
    }

    private async Task TriggerOcrScan()
    {
        isScanningOcr = true;
        ocrScanned = false;
        StateHasChanged();
        await Task.Delay(900);
        isScanningOcr = false;
        ocrScanned = true;
        if (string.IsNullOrWhiteSpace(idNumber))
        {
            idNumber = "8942-5018-9120";
        }
        StateHasChanged();
    }

    private void CaptureSelfie()
    {
        selfieCaptured = true;
    }

    private async Task SubmitRegistration()
    {
        isSubmitting = true;
        await Task.Delay(700);
        isSubmitting = false;
        currentStep = 5;
    }
}
