@page "/resident"
@layout Layout.EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Resident Workspace &bull; Sangguniang Barangay ng Talampas, Bustos, Bulacan</PageTitle>

<div class="d-flex flex-column min-vh-100 bg-white">
    <!-- Clean Top Navigation Bar (Always Visible) -->
    <header class="civic-navbar">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a class="civic-brand" href="/">
                    <img src="images/talampas-logo.png" alt="Barangay Talampas Logo" class="brand-crest" />
                    <div>
                        <div class="brand-title">OneSitio</div>
                        <div class="brand-subtitle">Sangguniang Barangay ng Talampas &bull; Bustos, Bulacan</div>
                    </div>
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-2">
                <a class="nav-link-custom active" href="/resident"><i class="bi bi-grid-fill me-1"></i> Workspace</a>
                <a class="nav-link-custom" href="/#services"><i class="bi bi-file-earmark-text me-1"></i> Services</a>
                <a class="nav-link-custom" href="/#tracker"><i class="bi bi-search me-1"></i> Track Requests</a>
                <a class="nav-link-custom" href="/#transparency"><i class="bi bi-shield-lock me-1"></i> Transparency</a>
                <a class="nav-link-custom" href="/"><i class="bi bi-globe me-1"></i> Public Portal</a>
            </nav>

            <!-- Resident Profile & Logout -->
            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-sm-inline badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 small fw-bold">
                    <i class="bi bi-patch-check-fill me-1"></i> Residente ng Talampas
                </span>
                <div class="d-flex align-items-center gap-2 p-1 rounded-pill border bg-light">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.825rem; background-color: #174836 !important;">
                        MS
                    </div>
                    <span class="small fw-bold text-dark pe-2 d-none d-sm-inline">Maria L. Santos</span>
                </div>
                <a href="/login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </a>
            </div>
        </div>
    </header>

    <!-- Workspace Main Body with Sidebar -->
    <div class="d-flex flex-grow-1">
        <!-- Figma Prototype Matching Left Sidebar -->
        <aside class="d-none d-md-flex flex-column justify-content-between p-4 border-end bg-white" style="width: 270px; min-width: 270px;">
            <div>
                <div class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.72rem; letter-spacing: 0.08em;">
                    Workspace Navigation
                </div>

                <!-- Nav Links -->
                <ul class="nav nav-pills flex-column gap-2">
                    <li class="nav-item">
                        <a class="nav-link active d-flex align-items-center gap-2 fw-bold" href="/resident" style="background-color: #eaf4ee; color: #174836; border-radius: 12px; padding: 0.75rem 1rem;">
                            <i class="bi bi-grid-fill"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary d-flex align-items-center gap-2 fw-semibold" href="/#services" style="padding: 0.75rem 1rem;">
                            <i class="bi bi-file-earmark-plus"></i> Request a Document
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary d-flex align-items-center gap-2 fw-semibold" href="/#tracker" style="padding: 0.75rem 1rem;">
                            <i class="bi bi-card-checklist"></i> My Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary d-flex align-items-center gap-2 fw-semibold" href="/#services" style="padding: 0.75rem 1rem;">
                            <i class="bi bi-wallet2"></i> Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary d-flex align-items-center gap-2 fw-semibold" href="/#transparency" style="padding: 0.75rem 1rem;">
                            <i class="bi bi-graph-up"></i> Transparency Portal
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Bottom Notice -->
            <div class="mt-4 pt-3 border-top">
                <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.75rem;">
                    <div class="fw-bold text-dark mb-1">A student-built prototype</div>
                    <div class="text-muted">BSIT semi-capstone &bull; Barangay Talampas, Bustos, Bulacan</div>
                    <div class="text-muted mt-2 pt-2 border-top" style="font-size: 0.7rem;">
                        Sample resident view &bull; No real authentication
                    </div>
                </div>

                <div class="mt-3">
                    <a href="/" class="btn btn-sm btn-outline-secondary w-100 fw-semibold rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Exit to Public Portal
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-grow-1 p-4 p-lg-5 bg-white">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="mb-4">
                    <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                        RESIDENT WORKSPACE &bull; BARANGAY TALAMPAS, BUSTOS, BULACAN
                    </div>
                    <h2 class="fw-bold mt-1 mb-1" style="font-size: 2.25rem; color: #174836;">Maligayang Pagbabalik, Maria!</h2>
                    <p class="text-muted small">Pamunuan ang inyong mga kahilingan sa Barangay Talampas sa isang lugar.</p>
                </div>

                <!-- Notice Banner (Matching Figma) -->
                <div class="fictional-notice-banner">
                    <i class="bi bi-info-circle-fill"></i>
                    <div class="small">
                        <strong>A student demo, not an active government service</strong><br />
                        All records are fictional demo entries for Sangguniang Barangay ng Talampas, Bustos, Bulacan.
                    </div>
                </div>

                <!-- How can we help you today? Cards -->
                <div class="mb-5">
                    <h5 class="fw-bold text-dark mb-3">Ano ang maitutulong namin sa inyo ngayon?</h5>
                    <div class="row g-3">
                        <div class="col-lg-3 col-sm-6">
                            <a href="/#services" class="proto-action-card proto-action-primary">
                                <div>
                                    <div class="proto-card-top">
                                        <i class="bi bi-file-earmark-plus proto-card-icon"></i>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-white">Request a Document</h6>
                                </div>
                                <div class="text-white-50 small mt-3">Magsimula ng aplikasyon</div>
                            </a>
                        </div>

                        <div class="col-lg-3 col-sm-6">
                            <a href="/#tracker" class="proto-action-card">
                                <div>
                                    <div class="proto-card-top text-dark">
                                        <i class="bi bi-card-checklist proto-card-icon text-muted"></i>
                                        <i class="bi bi-arrow-up-right text-muted"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">Aking mga Request</h6>
                                </div>
                                <div class="text-muted small mt-3">4 na aktibong transaksyon</div>
                            </a>
                        </div>

                        <div class="col-lg-3 col-sm-6">
                            <a href="/#services" class="proto-action-card">
                                <div>
                                    <div class="proto-card-top text-dark">
                                        <i class="bi bi-wallet2 proto-card-icon text-muted"></i>
                                        <i class="bi bi-arrow-up-right text-muted"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">Bayarin (Payments)</h6>
                                </div>
                                <div class="text-muted small mt-3">PayMongo fees & ledger</div>
                            </a>
                        </div>

                        <div class="col-lg-3 col-sm-6">
                            <a href="/#transparency" class="proto-action-card">
                                <div>
                                    <div class="proto-card-top text-dark">
                                        <i class="bi bi-graph-up proto-card-icon text-muted"></i>
                                        <i class="bi bi-arrow-up-right text-muted"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">Transparency Portal</h6>
                                </div>
                                <div class="text-muted small mt-3">Pondo ng Talampas</div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Two-Column Grid: Recent Requests & Resident Details -->
                <div class="row g-4">
                    <!-- Left: Recent requests table -->
                    <div class="col-lg-8">
                        <div class="bg-white rounded-4 border p-4 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">Kamakailang mga Kahilingan (Recent Requests)</h5>
                                <a href="/#tracker" class="small text-success text-decoration-none fw-bold">Tingnan lahat &rarr;</a>
                            </div>

                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                        <tr>
                                            <th scope="col" class="border-0">DOKUMENTO / REQUEST ID</th>
                                            <th scope="col" class="border-0">PETSA</th>
                                            <th scope="col" class="border-0 text-end">ESTADO</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark">Barangay Clearance</div>
                                                <div class="text-muted small">REQ-0264 &bull; Talampas Employment</div>
                                            </td>
                                            <td class="text-secondary small">Oct 22, 2026</td>
                                            <td class="text-end">
                                                <span class="badge badge-status badge-pending">Pending</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark">Certificate of Indigency</div>
                                                <div class="text-muted small">REQ-0261 &bull; Medical Subsidy</div>
                                            </td>
                                            <td class="text-secondary small">Oct 21, 2026</td>
                                            <td class="text-end">
                                                <span class="badge badge-status badge-under-review">Under Review</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark">Barangay Clearance</div>
                                                <div class="text-muted small">REQ-0252 &bull; Postal & Driver's License</div>
                                            </td>
                                            <td class="text-secondary small">Oct 18, 2026</td>
                                            <td class="text-end">
                                                <span class="badge badge-status badge-approved">Approved</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark">Barangay Clearance</div>
                                                <div class="text-muted small">REQ-0247 &bull; School Enrollment</div>
                                            </td>
                                            <td class="text-secondary small">Oct 15, 2026</td>
                                            <td class="text-end">
                                                <span class="badge badge-status badge-ready">Ready for Release</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Resident details & See bigger picture -->
                    <div class="col-lg-4">
                        <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
                            <h6 class="fw-bold text-dark mb-3">Detalye ng Residente</h6>
                            <div class="fw-bold text-dark fs-5">Maria L. Santos</div>
                            <p class="text-secondary small mt-1 mb-3">
                                24 Purok 3 (Gulod)<br />
                                Barangay Talampas, Bustos, Bulacan
                            </p>
                            <div class="d-flex justify-content-between align-items-center py-2 border-top border-bottom small">
                                <span class="text-muted">Resident ID</span>
                                <span class="fw-bold text-dark font-monospace">RES-TAL-2026-018</span>
                            </div>
                            <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                                Rehistradong profile sa Barangay Talampas.
                            </div>
                        </div>

                        <div class="p-4 rounded-4 border shadow-sm" style="background-color: #eaf4ee; border-color: #cce5d6 !important;">
                            <h6 class="fw-bold text-dark mb-2">Pondo at Proyekto ng Talampas</h6>
                            <p class="small text-secondary mb-3">
                                Tingnan ang live blockchain ledger ng mga pampublikong pondo at proyekto sa Bustos, Bulacan.
                            </p>
                            <a href="/#transparency" class="text-success fw-bold small text-decoration-none">
                                Buksan ang Transparency Portal &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
