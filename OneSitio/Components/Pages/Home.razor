@page "/"
@layout Layout.PublicLayout
@rendermode InteractiveServer

<PageTitle>OneSitio &bull; Sangguniang Barangay ng Talampas, Bustos, Bulacan</PageTitle>

<!-- Clean Hero Section -->
<section class="hero-wrapper">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <div class="hero-pill-badge mb-0">
                        <span class="dot"></span>
                        <span>Sangguniang Barangay ng Talampas &bull; Bustos, Bulacan</span>
                    </div>
                    <span class="badge bg-light text-success border border-success-subtle px-3 py-2 rounded-pill small fw-semibold">
                        <i class="bi bi-shield-lock-fill me-1"></i> Block #1,086 Verified
                    </span>
                </div>

                <h1 class="hero-title">
                    Modern, Fast & <span class="highlight">Cryptographically Verifiable</span> e-Barangay Services
                </h1>

                <p class="hero-subtitle">
                    Mag-request ng opisyal na Barangay Clearance, pamunuan ang pamilya at dependents, at suriin ang pondo ng Barangay Talampas na may cryptographic blockchain transparency.
                </p>

                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <a href="/register" class="btn btn-civic-primary btn-lg px-4 py-3">
                        <i class="bi bi-person-check-fill me-2 fs-5"></i>
                        Register as Resident
                    </a>
                    <a href="/login" class="btn btn-civic-outline btn-lg px-4 py-3">
                        <i class="bi bi-box-arrow-in-right me-2 fs-5"></i>
                        Resident Login
                    </a>
                    <a href="#tracker" class="btn btn-civic-ghost px-3 py-2 text-decoration-none">
                        <i class="bi bi-search me-1"></i> Track a Request
                    </a>
                </div>

                <div class="hero-stats-row">
                    <div class="stat-item">
                        <h4>100%</h4>
                        <p>Tamper-Evident SHA-256 Ledger</p>
                    </div>
                    <div class="stat-item">
                        <h4>Ages 15+</h4>
                        <p>Voter & Student ID Verification</p>
                    </div>
                    <div class="stat-item">
                        <h4>E-Wallet</h4>
                        <p>GCash, Maya, QR Ph, & Cards</p>
                    </div>
                    <div class="stat-item">
                        <h4>24–48h</h4>
                        <p>Clearance & Certificate Turnaround</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-card-showcase">
                    <div class="hero-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <img src="images/talampas-logo.png" alt="Talampas Logo" style="width: 28px; height: 28px; border-radius: 50%;" />
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">
                                <i class="bi bi-patch-check-fill me-1"></i> OneSitio Verified
                            </span>
                            <span class="text-muted small fw-semibold">Brgy. Talampas</span>
                        </div>
                        <span class="hero-card-tag">e-Citizen Portal</span>
                    </div>

                    <div class="hero-photo-container">
                        <img src="images/hero_barangay_portal.jpg" alt="Barangay Talampas Community" />
                        <div class="hero-photo-overlay">
                            <div class="fw-bold small">Online Citizen Service Delivery</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Mabilis na serbisyo para sa lahat ng Purok sa Barangay Talampas</div>
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-dark">
                                <i class="bi bi-file-earmark-check-fill text-success me-1"></i> Barangay Clearance
                            </span>
                            <span class="badge badge-status badge-approved">Approved & Ready</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                            <span>Applicant: Maria L. Santos</span>
                            <span>Ref: REQ-0252</span>
                        </div>
                        <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted"><i class="bi bi-credit-card me-1"></i> Paid via GCash</span>
                            <span class="fw-bold text-success small">₱50.00 &bull; Verified</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Live Request Tracking Section (Clean White) -->
<section id="tracker" class="py-5" style="background: #ffffff; border-bottom: 1px solid var(--border-color);">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="tracker-box">
                    <div class="mb-4">
                        <span class="section-tag mb-1 d-block"><i class="bi bi-radar me-1"></i> Real-Time Service Status</span>
                        <h3 class="fw-bold mb-1" style="color: #174836;">Subaybayan ang Inyong Request</h3>
                        <p class="text-muted small mb-0">Ilagay ang inyong Reference Code (Halimbawa: REQ-0252 o REQ-0264) upang makita ang pinakabagong estado.</p>
                    </div>

                    <div class="input-group mb-4">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control form-control-lg border-start-0" placeholder="Ilagay ang Reference Code (Hal. REQ-0252)" @bind="searchTrackingCode" />
                        <button class="btn btn-civic-primary px-4 fw-semibold" @onclick="SearchTracker">
                            Track Request
                        </button>
                    </div>

                    @if (searchPerformed && currentTrackResult == null)
                    {
                        <div class="alert alert-warning py-2 px-3 rounded-3 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-info-circle-fill"></i>
                            <div>Mangyaring maglagay ng valid na Reference Code (Halimbawa: <strong>REQ-0252</strong> o <strong>REQ-0264</strong>).</div>
                        </div>
                    }

                    @if (currentTrackResult != null)
                    {
                        <div class="p-4 bg-light rounded-4 border">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">@currentTrackResult.DocTitle</h5>
                                    <div class="text-muted small">Tracking ID: <span class="fw-bold text-dark font-monospace">@currentTrackResult.Code</span> &bull; Beneficiary: @currentTrackResult.Beneficiary</div>
                                </div>
                                <span class="badge badge-status @currentTrackResult.BadgeClass fs-6 px-3 py-2">
                                    @currentTrackResult.StatusText
                                </span>
                            </div>

                            <!-- Stepper -->
                            <div class="tracker-status-stepper">
                                <div class="tracker-step-item @(currentTrackResult.Step >= 1 ? "completed" : "")">
                                    <div class="tracker-step-icon">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <div class="tracker-step-label">1. Request Submitted</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Oct 18, 2026</div>
                                </div>
                                <div class="tracker-step-item @(currentTrackResult.Step >= 2 ? "completed" : (currentTrackResult.Step == 1 ? "active" : ""))">
                                    <div class="tracker-step-icon">
                                        <i class="bi @(currentTrackResult.Step >= 2 ? "bi-check-lg" : "bi-eye")"></i>
                                    </div>
                                    <div class="tracker-step-label">2. Secretary Verification</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">OCR & Talampas Registry</div>
                                </div>
                                <div class="tracker-step-item @(currentTrackResult.Step >= 3 ? "completed" : (currentTrackResult.Step == 2 ? "active" : ""))">
                                    <div class="tracker-step-icon">
                                        <i class="bi @(currentTrackResult.Step >= 3 ? "bi-check-lg" : "bi-credit-card")"></i>
                                    </div>
                                    <div class="tracker-step-label">3. E-Wallet Payment</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">₱50.00 Cleared</div>
                                </div>
                                <div class="tracker-step-item @(currentTrackResult.Step >= 4 ? "completed" : (currentTrackResult.Step == 3 ? "active" : ""))">
                                    <div class="tracker-step-icon">
                                        <i class="bi @(currentTrackResult.Step >= 4 ? "bi-patch-check-fill" : "bi-box-seam")"></i>
                                    </div>
                                    <div class="tracker-step-label">4. Ready for Release</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Talampas Barangay Hall</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 text-secondary small">
                                <span><i class="bi bi-info-circle text-success me-1"></i> Purpose: @currentTrackResult.Purpose</span>
                                <a href="/login" class="text-success fw-bold text-decoration-none">
                                    View in Resident Portal <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Official Documents Section (All-White) -->
