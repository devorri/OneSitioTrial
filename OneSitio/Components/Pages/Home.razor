@code {
    private string searchTrackingCode = "";
    private TrackResult? currentTrackResult;
    private bool searchPerformed = false;

    private void SearchTracker()
    {
        if (string.IsNullOrWhiteSpace(searchTrackingCode))
        {
            currentTrackResult = null;
            searchPerformed = true;
            return;
        }

        searchPerformed = true;
        var query = searchTrackingCode.Trim();

        if (query.Equals("REQ-0264", StringComparison.OrdinalIgnoreCase))
        {
            currentTrackResult = new TrackResult
            {
                Code = "REQ-0264",
                DocTitle = "Barangay Clearance",
                Beneficiary = "Maria L. Santos (Purok 3, Talampas)",
                Purpose = "Local Employment (Bustos Commercial Center)",
                StatusText = "Pending Verification",
                BadgeClass = "badge-pending",
                Step = 1
            };
        }
        else if (query.Equals("REQ-0261", StringComparison.OrdinalIgnoreCase))
        {
            currentTrackResult = new TrackResult
            {
                Code = "REQ-0261",
                DocTitle = "Certificate of Indigency",
                Beneficiary = "Maria L. Santos (Self)",
                Purpose = "Tulong Medikal sa Bulacan Provincial Hospital",
                StatusText = "Under Secretary Review",
                BadgeClass = "badge-under-review",
                Step = 2
            };
        }
        else
        {
            currentTrackResult = new TrackResult
            {
                Code = query.ToUpper(),
                DocTitle = "Barangay Clearance",
                Beneficiary = "Residente ng Talampas",
                Purpose = "Official Civic Processing & Verification",
                StatusText = "Approved · Ready for Release",
                BadgeClass = "badge-approved",
                Step = 4
            };
        }
    }

    public class TrackResult
    {
        public string Code { get; set; } = "";
        public string DocTitle { get; set; } = "";
        public string Beneficiary { get; set; } = "";
        public string Purpose { get; set; } = "";
        public string StatusText { get; set; } = "";
        public string BadgeClass { get; set; } = "";
        public int Step { get; set; } = 4;
    }
}
